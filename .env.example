# Required: OpenAI API key (or any OpenAI-compatible endpoint key).
OPENAI_API_KEY="sk-..."

# Optional: override the OpenAI base URL to target a compatible endpoint
# (e.g. https://api.openai.com/v1, https://api.your-provider.com/v1).
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Optional: target model for `haiku` and `sonnet` requests from Claude Code.
# Defaults below match real OpenAI; set both to the same name to route every
# request to a single custom model.
# BIG_MODEL="gpt-4.1"
# SMALL_MODEL="gpt-4.1-mini"

# Optional: per-tier overrides that take precedence over BIG_MODEL / SMALL_MODEL.
# If unset, each tier falls back to the corresponding BIG/Small default above.
# Useful when you want e.g. a stronger model for opus but the default for sonnet.
# HAIKU_MODEL="gpt-4.1-mini"
# SONNET_MODEL="gpt-4.1"
# OPUS_MODEL="gpt-4.1"
# FABLE_MODEL="gpt-4.1"
# MYTHOS_MODEL="gpt-4.1"

# Optional: disable TLS certificate validation when OPENAI_BASE_URL uses an
# HTTPS endpoint with a self-signed certificate (common for local LLM servers).
# Accepts true/false, 1/0, yes/no, on/off (case-insensitive). Default: true.
# OPENAI_TLS_VERIFY="false"