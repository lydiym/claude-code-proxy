# Every key optional; config.toml (if next to server.py) wins per key. Env vars are for Docker/runtime overrides.

# CONFIG_PATH="./config.toml"  # default

# Required (or [proxy].openai_api_key in config.toml). Any OpenAI-compatible key works.
OPENAI_API_KEY="sk-..."

# OPENAI_BASE_URL="https://api.openai.com/v1"  # optional; or [proxy].openai_base_url

# BIG_MODEL="gpt-4.1"         # default for sonnet/opus/fable/mythos; or [big].model
# SMALL_MODEL="gpt-4.1-mini"  # default for haiku; or [small].model

# {tier}_MODEL overrides both [big]/[small] and [tier].model for that tier. Optional; or [tier].model.
# HAIKU_MODEL="gpt-4.1-mini"
# SONNET_MODEL="gpt-4.1"
# OPUS_MODEL="gpt-4.1"
# FABLE_MODEL="gpt-4.1"
# MYTHOS_MODEL="gpt-4.1"

# OPENAI_TLS_VERIFY="false"  # for self-signed certs on local LLMs. Default: true.

# TIKTOKEN_OFFLINE="true"  # stub tiktoken on isolated networks (skip Azure blob fetch). Default: true.

# LOG_LEVEL="INFO"  # DEBUG dumps effective upstream sampling params + extra_body per request

# LITELLM_DEBUG_HTTP="false"  # verbose: dump full litellm kwargs/response, enable litellm.set_verbose + httpx/httpcore DEBUG. Use with LOG_LEVEL=DEBUG.

# HOST="127.0.0.1"  # uvicorn bind address. Default 127.0.0.1 (loopback only). Set to 0.0.0.0 for Docker/LAN.
# PORT="8082"       # uvicorn bind port. Default 8082.
