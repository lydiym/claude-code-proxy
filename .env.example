# Every key here is optional. If config.toml exists next to server.py, it
# takes precedence over the corresponding env var per key (so .env can be
# omitted entirely). Env vars exist for Docker / runtime overrides.

# Path to the TOML config file. Default: ./config.toml
# CONFIG_PATH="./config.toml"

# Required (or set openai_api_key in [proxy] in config.toml): OpenAI API key,
# or a key for any OpenAI-compatible endpoint.
OPENAI_API_KEY="sk-..."

# Optional (or set openai_base_url in [proxy] in config.toml): override the
# OpenAI base URL to target a compatible endpoint
# (e.g. https://api.openai.com/v1, https://api.your-provider.com/v1).
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Optional (or set big_model / small_model in [routing] in config.toml):
# target model for `haiku` and `sonnet` requests from Claude Code.
# Defaults below match real OpenAI; set both to the same name to route every
# request to a single custom model.
# BIG_MODEL="gpt-4.1"
# SMALL_MODEL="gpt-4.1-mini"

# Optional (or set {tier}_model in [routing] in config.toml): per-tier
# overrides that take precedence over BIG_MODEL / SMALL_MODEL.
# If unset, each tier falls back to the corresponding BIG/Small default above.
# HAIKU_MODEL="gpt-4.1-mini"
# SONNET_MODEL="gpt-4.1"
# OPUS_MODEL="gpt-4.1"
# FABLE_MODEL="gpt-4.1"
# MYTHOS_MODEL="gpt-4.1"

# Optional (or set openai_tls_verify in [proxy] in config.toml): disable TLS
# certificate validation when OPENAI_BASE_URL uses an HTTPS endpoint with a
# self-signed certificate (common for local LLM servers).
# Accepts true/false, 1/0, yes/no, on/off (case-insensitive). Default: true.
# OPENAI_TLS_VERIFY="false"

# Optional (or set tiktoken_offline in [proxy] in config.toml): stub tiktoken
# to skip the cl100k_base.tiktoken download from Azure blob storage — required
# on isolated networks where DNS fails.
# Accepts true/false, 1/0, yes/no, on/off (case-insensitive). Default: true.
# TIKTOKEN_OFFLINE="true"
