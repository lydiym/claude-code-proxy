# Single source of truth. Every key optional; lookup: env → config → default. LOG_LEVEL is env-only.

[proxy]
openai_api_key    = "sk-..."                      # env: OPENAI_API_KEY
openai_base_url   = "http://localhost:8081/v1"    # env: OPENAI_BASE_URL (optional)
openai_tls_verify = true                          # env: OPENAI_TLS_VERIFY (default true)
tiktoken_offline  = true                          # env: TIKTOKEN_OFFLINE (default true)

[routing]
big_model      = "gpt-4.1"     # env: BIG_MODEL      (default gpt-4.1)
small_model    = "gpt-4.1-mini"  # env: SMALL_MODEL    (default gpt-4.1-mini)
# haiku_model    = "qwen3.5"     # env: HAIKU_MODEL    (optional; defaults to small_model)
# sonnet_model   = "qwen3.5"     # env: SONNET_MODEL   (optional; defaults to big_model)
# opus_model     = "gpt-4.1"     # env: OPUS_MODEL     (optional; defaults to big_model)
# fable_model    = "gpt-4.1"     # env: FABLE_MODEL    (optional; defaults to big_model)
# mythos_model   = "gpt-4.1"     # env: MYTHOS_MODEL   (optional; defaults to big_model)

# --- Per-tier settings ---
# [global] is fallback; tier sections deep-merge over it. Config wins per leaf.
# Sampling: config wins per key; omitted when neither sets it. extra_body -> upstream backend knobs.

# [global]
# extra_body = { cache_prompt = true }

# [haiku]
# temperature = 0.3
# top_p       = 0.9
# top_k       = 40
# extra_body = { cache_prompt = true, n_predict = 4096, chat_template_kwargs = { enable_thinking = false } }

# [sonnet]
# temperature = 0.7
# extra_body = { chat_template_kwargs = { enable_thinking = false } }

# [opus]
# extra_body = { cache_prompt = true }
# temperature = 0.5

# [fable]
# ...

# [mythos]
# ...
