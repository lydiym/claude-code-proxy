# config.toml — single source of truth for the proxy.
# Every key is optional. Missing keys fall back to the equivalent env var
# (OPENAI_API_KEY, OPENAI_BASE_URL, BIG_MODEL, HAIKU_MODEL, etc.) — useful for
# Docker, where env vars override baked-in defaults at runtime.
#
# Lookup order per key: [proxy]/[routing] entry → env var → inline default.
# Place this file next to server.py or point CONFIG_PATH at it.

[proxy]
# openai_api_key    = "sk-..."                      # env: OPENAI_API_KEY
# openai_base_url   = "http://localhost:8081/v1"    # env: OPENAI_BASE_URL (optional)
# openai_tls_verify = true                          # env: OPENAI_TLS_VERIFY (default true)
# tiktoken_offline  = true                          # env: TIKTOKEN_OFFLINE (default true)

[routing]
# big_model      = "gpt-4.1"     # env: BIG_MODEL      (default gpt-4.1)
# small_model    = "gpt-4.1-mini"  # env: SMALL_MODEL    (default gpt-4.1-mini)
# haiku_model    = "qwen3.5"     # env: HAIKU_MODEL    (optional; defaults to small_model)
# sonnet_model   = "qwen3.5"     # env: SONNET_MODEL   (optional; defaults to big_model)
# opus_model     = "gpt-4.1"     # env: OPUS_MODEL     (optional; defaults to big_model)
# fable_model    = "gpt-4.1"     # env: FABLE_MODEL    (optional; defaults to big_model)
# mythos_model   = "gpt-4.1"     # env: MYTHOS_MODEL   (optional; defaults to big_model)

# --- Per-tier settings (the actual feature) ---
# Sections: [global], [haiku], [sonnet], [opus], [fable], [mythos].
# [global] applies to every tier that has no explicit section. A tier-specific
# section deep-merges over [global] at each leaf — tier keys win where they
# overlap, unrelated keys from [global] are preserved.
#
# Sampling fields: config value wins over the request value at the key level.
# When neither config nor the request sets a key, it is OMITTED from the
# upstream call (we never auto-apply Anthropic defaults like temperature=1.0).
#
# extra_body: passed through to LiteLLM, which merges it into the upstream
# request body at top level. Use it for backend-specific knobs that aren't
# standard OpenAI params: cache_prompt, n_predict, chat_template_kwargs, etc.

[global]
# extra_body = { cache_prompt = true }

[haiku]
temperature = 0.3
top_p       = 0.9
top_k       = 40

[haiku.extra_body]
cache_prompt = true
n_predict    = 4096

[haiku.extra_body.chat_template_kwargs]
# Qwen3.5+ emits <think>…</think> by default; turn it off for fast tier.
enable_thinking = false

[sonnet]
temperature = 0.7

[sonnet.extra_body.chat_template_kwargs]
enable_thinking = false

# [opus]
# extra_body = { cache_prompt = true }
# temperature = 0.5

# [fable]
# ...

# [mythos]
# ...
